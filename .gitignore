# The MPL-2.0 onenote reference checkout — deliberately untracked. It was once
# a broken gitlink (no .gitmodules); the index entry was removed, and it must
# not come back as a plain directory either: it is licence-incompatible
# reference material, not part of the build.
/rust/onote_core/onenote-ref/

# Temporary diagnostic probes; functional regression tests use normal names.
app/test/zz*_test.dart

# Local tool caches (including leftovers from the removed website).
.wrangler/
node_modules/

# Release artifacts, when the packaging steps are reproduced locally. CI
# uploads these from the runner; they have no business in the tree.
/openote-*.AppImage
/openote-*.tar.gz
/openote-*.zip
/openote-*-setup.exe
/openote-scanner.apk
/AppDir/
/appimagetool
/installer-stage-*/
/packaging/windows/openote-*-setup.exe

# Locally generated Android release credentials. This file is deliberately
# ignored so its Base64 keystore and passwords can never be committed.
/ANDROID_SECRETS_PRIVATE.txt
/openote-release.jks
